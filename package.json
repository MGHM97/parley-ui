{
  "name": "parley-ui",
  "version": "0.2.0",
  "description": "Accessible React components for AI interfaces.",
  "license": "MIT",
  "author": "Mateus Vieira <mateusoliveira469@gmail.com>",
  "homepage": "https://mghm97.github.io/parley-ui/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MGHM97/parley-ui.git"
  },
  "bugs": {
    "url": "https://github.com/MGHM97/parley-ui/issues"
  },
  "keywords": [
    "react",
    "accessibility",
    "a11y",
    "ai",
    "llm",
    "chat",
    "streaming",
    "aria-live"
  ],
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css"
  },
  "packageManager": "yarn@1.22.22",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsdown",
    "dev": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "test": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "prepare": "tsdown",
    "size": "size-limit",
    "check:package": "yarn pack --filename parley-ui.tgz && publint run parley-ui.tgz --strict && attw parley-ui.tgz --profile esm-only --exclude-entrypoints ./styles.css"
  },
  "peerDependencies": {
    "react": "^18.2.0 || ^19.0.0",
    "react-dom": "^18.2.0 || ^19.0.0"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@eslint/js": "^9",
    "@size-limit/preset-small-lib": "^14.3.0",
    "@storybook/addon-a11y": "^10.6.5",
    "@storybook/addon-docs": "^10.6.5",
    "@storybook/react-vite": "^10.6.5",
    "@testing-library/dom": "^10",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "axe-core": "^4.14.0",
    "eslint": "^9",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "jsdom": "^30.1.3",
    "prettier": "^3.9.10",
    "publint": "^0.3.25",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "size-limit": "^14.3.0",
    "storybook": "^10.6.5",
    "tsdown": "^0.23.5",
    "typescript": "^6",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vitest": "^5.1.0"
  }
}
